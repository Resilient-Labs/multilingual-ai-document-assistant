# Copy to `.env.local` and fill in secrets. Do not commit `.env.local`.

# /api/translate provider chain (priority order, top wins):
#
#   1. HF_TRANSLATE_ENDPOINT_URL — dedicated translation pipeline endpoint
#      (NLLB-200 / M2M-100 / Marian). Purpose-built for translation,
#      lower latency than prompting a chat model. Shape:
#         POST / {"inputs":"<text>","parameters":{"src_lang":"eng_Latn","tgt_lang":"<flores>"}}
#         200  [{"translation_text":"..."}]
#   2. HF_INFERENCE_ENDPOINT_URL — chat-model inference endpoint (also
#      used by /api/ask and /api/safety). Prompted to translate.
HF_TRANSLATE_ENDPOINT_URL=

# Chat-model HF Inference Endpoint — required for `/api/ask` and
# `/api/safety`; secondary for /api/translate. Custom-handler endpoint
# that accepts {"inputs":{"messages":[...]}} and returns
# {"generated_text":"..."}.
HF_INFERENCE_ENDPOINT_URL=

# Hugging Face Space — Read Aloud / TTS (Coqui).
HF_TTS_SPACE_URL=https://resilient-coders-aidoc-tts.hf.space
# Optional: deploy Resilient-Coders/coqui-vctk-en to an HF Inference Endpoint
# (infra/tts-handlers/en/handler.py) for always-warm English TTS. When set,
# the app calls the endpoint directly instead of the Space.
# HF_TTS_ENDPOINT_EN=https://kqb8pjk2dlp2yay8.eu-west-1.aws.endpoints.huggingface.cloud

# Hugging Face Inference Providers — Ask (`/api/ask`) legacy router fallback +
# Summarize (`/api/summarize`). `HF_TOKEN` is required for the legacy Ask path
# AND for Summarize. Model/base overrides are optional (routes have defaults).
# When HF_INFERENCE_ENDPOINT_URL is set, HF_ASK_MODEL / HF_ASK_BASE_URL are ignored
# by /api/ask. HF_TOKEN is still forwarded as Bearer auth to the inference
# endpoint when set.
HF_TOKEN=
HF_ASK_MODEL=meta-llama/Llama-3.1-8B-Instruct:cheapest
HF_ASK_BASE_URL=https://router.huggingface.co/v1
HF_SUMMARIZE_MODEL=meta-llama/Llama-3.1-8B-Instruct:cheapest

# TTS gender (English VCTK); defaults match code if you omit these.
COQUI_TTS_FEMININE_SPEAKER=p228
COQUI_TTS_MASCULINE_SPEAKER=p226

# Optional: LangSmith tracing + Ask / evaluateAsync (`lib/langsmithAskRun.ts`, `lib/evaluate.ts`).
# Set LANGSMITH_TRACING=true when LANGSMITH_API_KEY is set. Use ASK_LANGSMITH_RECORD_IO only on staging (PII).
LANGSMITH_API_KEY=
LANGSMITH_TRACING=
LANGSMITH_PROJECT=multilingual-doc-assistant
ASK_LANGSMITH_RECORD_IO=
EVALUATIONS_ENABLED=

# Optional: Playwright base URL for E2E.
# PLAYWRIGHT_BASE_URL=http://localhost:3000
