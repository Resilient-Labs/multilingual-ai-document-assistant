# Copy to .env.local if needed
# Zero-retention architecture: no server-side storage.

# --- API security ---
# Internal API calls now use same-origin CSRF protection.
# No browser-exposed API secret is required.
# OPEN_ROUTER_API_TOKEN=

# --- Upstash Redis (rate limiting) ---
# Create a free database at https://console.upstash.com
# Required in production. Local development skips rate limiting when unset.
# UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-token

# --- Third-party API keys ---
# OPENAI_API_KEY=
# DEEPL_API_KEY=
# DEEPGRAM_API_KEY=
# REPLICATE_API_TOKEN=
# XTTS_REPLICATE_MODEL=lucataco/xtts-v2
# XTTS_SPEAKER_WAV_URL=https://raw.githubusercontent.com/lucataco/cog-xtts-v2/main/female.wav
# MINIMAX_REPLICATE_MODEL=minimax/speech-02-turbo
# MINIMAX_FEMININE_VOICE_ID=Wise_Woman
# MINIMAX_MASCULINE_VOICE_ID=Deep_Voice_Man
# MINIMAX_AUDIO_FORMAT=mp3
