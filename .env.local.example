# Copy to .env.local if needed
# Zero-retention architecture: no server-side storage.

# --- Auth ---
# Shared secret used to authenticate all /api/* requests.
# Generate with: openssl rand -hex 32
# Both variables must be set to the same value.
# The NEXT_PUBLIC_ variant is read by the browser; the plain variant is used by the middleware.
# NEXT_PUBLIC_API_SECRET_KEY=replace-with-a-random-secret
# OPEN_ROUTER_API_TOKEN=

# --- Third-party API keys ---
# OPENAI_API_KEY=
# DEEPL_API_KEY=
# DEEPGRAM_API_KEY=
# REPLICATE_API_TOKEN=
# XTTS_REPLICATE_MODEL=lucataco/xtts-v2
# XTTS_SPEAKER_WAV_URL=https://raw.githubusercontent.com/lucataco/cog-xtts-v2/main/female.wav
# MINIMAX_REPLICATE_MODEL=minimax/speech-02-turbo
# MINIMAX_FEMININE_VOICE_ID=Wise_Woman
# MINIMAX_MASCULINE_VOICE_ID=Deep_Voice_Man
# MINIMAX_AUDIO_FORMAT=mp3
